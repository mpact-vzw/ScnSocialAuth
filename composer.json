{
    "name": "mpact-vzw/scn-social-auth",
    "description": "Port to Laminas. Uses the HybridAuth PHP library to Enable authentication via Google, Facebook, Twitter, Yahoo!, etc for the LmcUser Laminas module.",
    "type": "library",
    "license": "BSD-3-Clause",
    "keywords": [
        "laminas",
        "facebook"
    ],
    "homepage": "https://github.com/SocalNick/ScnSocialAuth",
    "authors": [
        {
            "name": "Nicholas Calugar",
            "email": "njcalugar@gmail.com",
            "homepage": "http://socalnick.github.com/"
        },
        {
            "name": "Bart lateur",
            "email": "bart.lateur@moact.be"
        }
    ],
    "require": {
        "php": ">=5.3.3",
        "laminas/laminas-authentication": "^2.18",
        "lm-commons/lmc-user": "3.*",
        "hybridauth/hybridauth": "3.*"
    },
    "require-dev": {
        "mockery/mockery": "0.8.0"
    },
    "autoload": {
        "psr-0": {
            "ScnSocialAuth": "src/",
            "ScnSocialAuthTest": "test/"
        },
        "classmap": [
            "./"
        ]
    }
}
